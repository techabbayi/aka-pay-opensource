{
  "name": "aka-pay",
  "version": "1.0.0",
  "type": "module",
  "description": "AKA PAY: UPI & Payment Infrastructure, Also Known As. Always Connected. Self-hosted sovereign UPI payment gateway.",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node scripts/clean.js",
    "db:setup": "node scripts/init-db.cjs",
    "sync:package": "node scripts/sync-package.cjs",
    "start": "node scripts/start.js",
    "start:prod": "node scripts/start.js",
    "start:prod:api": "node apps/payment-api/src/index.js",
    "dev": "node scripts/dev.js",
    "test": "node scripts/test-all.js",
    "test:all": "node scripts/test-all.js",
    "test:acceptance": "node --test scripts/production-infrastructure.test.js",
    "build:android:apk": "node scripts/build-android-apk.js",
    "sync:android-allowlist": "node scripts/sync-android-allowlist.js",
    "typecheck": "tsc -b --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "author": {
    "name": "techabbayi",
    "email": "srssltd@gmail.com",
    "url": "https://github.com/techabbayi"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/techabbayi/aka-pay-opensource.git"
  },
  "homepage": "https://github.com/techabbayi/aka-pay-opensource#readme",
  "bugs": {
    "url": "https://github.com/techabbayi/aka-pay-opensource/issues",
    "email": "srssltd@gmail.com"
  },
  "license": "Apache-2.0",
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "protobufjs@8.8.1": true,
    "protobufjs@7.6.6": true
  }
}
